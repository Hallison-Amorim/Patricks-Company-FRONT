# ==========================================================
# EMPREST.AI — Modelo de .env do frontend (copie para .env)
# Stack alvo: React + Vite + TypeScript
# No Vite, toda variável precisa do prefixo VITE_ para chegar ao app.
# ==========================================================

# --- API do backend (produção — Vercel) ---
VITE_API_URL=https://back-kappa-khaki.vercel.app/api

# --- Supabase Auth ---
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# --- API do backend (desenvolvimento local) ---
# Descomente para rodar na sua máquina (e comente a de produção acima).
# VITE_API_URL=http://localhost:3000/api

# --- Identidade do app ---
VITE_APP_NAME="EMPREST.AI"
